{
  "id": "toolkit-product-owner-bridge",
  "name": "Toolkit Product Owner Bridge",
  "description": "Explicit owner-only product command admission and real review receipt capture; no model tool or automatic activation.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "stateDir",
      "python",
      "checkout",
      "engineConfig",
      "engineState",
      "signingKeyEnv",
      "environmentKeys",
      "routes"
    ],
    "properties": {
      "stateDir": {
        "type": "string"
      },
      "python": {
        "type": "string"
      },
      "checkout": {
        "type": "string"
      },
      "engineConfig": {
        "type": "string"
      },
      "engineState": {
        "type": "string"
      },
      "signingKeyEnv": {
        "type": "string"
      },
      "environmentKeys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "routes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "allowNetwork": {
        "type": "boolean",
        "default": false
      },
      "allowWrites": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
