{
  "id": "toolkit-product-owner-bridge",
  "name": "Toolkit Product Owner Bridge",
  "description": "Explicit owner-only product command admission and real review receipt capture; no model tool or automatic activation.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "stateDir",
      "python",
      "checkout",
      "engineConfig",
      "engineState",
      "signingKeyEnv",
      "environmentKeys",
      "routes",
      "supportAgentIds"
    ],
    "properties": {
      "stateDir": {
        "type": "string"
      },
      "python": {
        "type": "string"
      },
      "checkout": {
        "type": "string"
      },
      "engineConfig": {
        "type": "string"
      },
      "engineState": {
        "type": "string"
      },
      "signingKeyEnv": {
        "type": "string"
      },
      "environmentKeys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "routes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "channel",
            "account",
            "peer",
            "role",
            "agent",
            "sessionKey"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            },
            "peer": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "owner"
            },
            "agent": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            },
            "sessionKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "senderAliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "chatAliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "minItems": 1
      },
      "allowNetwork": {
        "type": "boolean",
        "default": false
      },
      "allowWrites": {
        "type": "boolean",
        "default": false
      },
      "supportAgentIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        }
      }
    }
  }
}
