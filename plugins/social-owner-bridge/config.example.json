{
  "stateDir": "/operator/private-social-native-receipts",
  "python": "/operator/venv/bin/python",
  "checkout": "/operator/automation-toolkit",
  "engineConfig": "/operator/private-social-config.json",
  "engineState": "/operator/private-social-state",
  "signingKeyEnv": "SOCIAL_BRIDGE_KEY",
  "environmentKeys": [
    "SOCIAL_BRIDGE_KEY"
  ],
  "allowNetwork": false,
  "allowWrites": false,
  "routes": [
    {
      "channel": "telegram",
      "account": "shop-account",
      "peer": "owner-peer",
      "role": "owner",
      "chatAliases": [
        "telegram:owner-peer"
      ],
      "agent": "main",
      "sessionKey": "agent:main:telegram:shop-account:direct:owner-peer"
    },
    {
      "channel": "whatsapp",
      "account": "second-shop-account",
      "peer": "configured-owner-phone",
      "role": "owner",
      "senderAliases": [
        "configured-owner-jid"
      ],
      "chatAliases": [
        "configured-owner-jid"
      ],
      "agent": "main",
      "sessionKey": "agent:main:whatsapp:second-shop-account:direct:configured-owner-phone"
    }
  ],
  "supportAgentIds": [
    "customer-support"
  ]
}
