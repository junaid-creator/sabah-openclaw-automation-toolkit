# Optional local state directory; no credentials required by offline examples.
TOOLKIT_STATE_DIR=./state

# Optional operations settings; no live enablement or credentials supplied.
TOOLKIT_TIMEZONE=UTC
TOOLKIT_SERIES_ID=daily-products-v1
TOOLKIT_HOUR=16
TOOLKIT_MINUTE=0
TOOLKIT_PRODUCT_HOST=example.com
TOOLKIT_WHATSAPP_ACCOUNT=default
TOOLKIT_TELEGRAM_ACCOUNT=default
# TOOLKIT_GATEWAY_HOST=your-approved-host
# TOOLKIT_GATEWAY_PORT=18789
# TOOLKIT_ALLOW_LIVE_META is intentionally unset.
# TOOLKIT_META_* credentials must come from your secret manager.
